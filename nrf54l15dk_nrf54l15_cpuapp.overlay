/* For more help, browse the devicetree documentation at https://docs.zephyrproject.org/latest/build/dts/index.html
 * You can also visit the nRF DeviceTree extension documentation at https://docs.nordicsemi.com/bundle/nrf-connect-vscode/page/guides/ncs_configure_app.html#devicetree-support-in-the-extension
 */
&pinctrl {
	spi21_default: spi21_default{
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,	1,	11)>,
				<NRF_PSEL(SPIM_MOSI,	1,	12)>;
		};
	};
	spi21_sleep: spi21_sleep{
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,	1,	11)>,
				<NRF_PSEL(SPIM_MOSI,	1,	12)>;
			low-power-enable;
		};
	};
};
&spi21 {
	status	= "okay";
	pinctrl-0 = <&spi21_default>;
	pinctrl-1 = <&spi21_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio2 8 GPIO_ACTIVE_LOW>;
};
/{
	chosen {
		zephyr,display = &epd;
	};

	mipi_dbi_epaper{
		compatible	= "zephyr, mipi-dbi-spi";
		spi-dev		= <&spi21>;
		dc_gpios	= <&gpio2 10 GPIO_ACTIVE_HIGH>;
		reset_gpios	= <&gpio2 7  GPIO_ACTIVE_LOW>;
		#address-cells	= <1>;
		#size-cells	= <0>;

		epd: ssd16xxfb@0{
			compatible		= "gooddisplay,gdey0213b74","solomon,ssd1680";
			mipi-max-frecuency	= <4000000>;
			reg			= <0>;
			width			= <250>;
			height			= <122>;
			busy-gpios		= <&gpio2 6 GPIO_ACTIVE_HIGH>;
			tssv			= <0x80>;
			full			  {border-waveform = <0x05>;};
			partial			  {border-waveform = <0x3c>;};

		};
	};
};

